APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# file is fastest for local dev; use database/redis when you outgrow it
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file is fastest for local dev (no MySQL round-trip per request)
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transactional email — all user mail is sent through Resend (resend/laravel).
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@aquilala.me"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenWeatherMap (real-time weather — free 2.5 endpoints)
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
OPENWEATHER_FORECAST_API_URL=https://api.openweathermap.org/data/2.5/forecast

# Development/test sign-in credentials for seeded accounts
# (used by DatabaseSeeder and EnsureTestAccessSeeder).
# Note: the admin account is not seeded — it is created interactively
# via `php artisan aquilala:create-admin`.
SEED_FARMER_PASSWORD=secret_farmer
SEED_STORE_PASSWORD=secret_store

# Tesseract OCR — optional. Used only by "Import from Scanned Document".
# Set the path to the tesseract executable, or leave empty to resolve the
# `tesseract` command from the system PATH.
TESSERACT_PATH='C:\Program Files\Tesseract-OCR\tesseract.exe'
TESSERACT_LANG=eng

# Groq (LLM) — optional. Powers the AI features: the assistant chat, the
# product import "AI fix" button, and AI field matching on OCR member import
# (the scan's text is sent to Groq for that last one). Leave empty and every
# AI feature falls back to the built-in rules with no request sent.
GROQ_API_KEY=

# Web Push (VAPID) ??" optional. Powers outside-the-app notifications (installed
# PWA / browser push). Generate a pair with `php artisan push:generate-keys` and
# paste it here. Leave empty and push quietly does nothing; the app is
# unaffected. Keep the same keys on every environment that should deliver to
# devices already subscribed (changing keys strands existing subscriptions).
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# Novu (novu.co) — notification infrastructure. OPTIONAL: with these empty
# every Novu call is skipped and the app behaves exactly as before.
# Dashboard → Settings → API Keys gives NOVU_APP_ID + NOVU_API_KEY (Dev and
# Production environments each have their own pair). NOVU_WORKFLOW_NOTICE is
# the shared workflow's trigger identifier (Workflows → Trigger tab); its
# templates read {{payload.title}} / {{payload.body}} / {{payload.link}}.
# NOVU_HMAC_SECRET is optional (Settings → Security → enable HMAC).
# NOVU_PUSH_ENABLED flips to true ONLY after the workflow's Push step is
# live — it retires the VAPID sender above so devices are never doubled.
NOVU_APP_ID=
NOVU_API_KEY=
NOVU_HMAC_SECRET=
NOVU_WORKFLOW_NOTICE=aquilala-important-notice
NOVU_PUSH_ENABLED=false

# Firebase Cloud Messaging — the provider Novu routes WEB PUSH through
# (free Firebase project: console → Project settings → General → your web
# app's config below; FIREBASE_VAPID_KEY = Web Push certificate key under
# Cloud Messaging). The web config is public by design. Leave empty and the
# browser-push half simply stays off.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
